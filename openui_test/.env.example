# Queryable Chatbot — frontend configuration (copy to .env.local)
# The frontend holds NO API keys. All /api/* calls are proxied to FastAPI.

# FastAPI backend the /api/* rewrite forwards to
BACKEND_URL=http://127.0.0.1:8000
# Must match the backend's SESSION_COOKIE_NAME (used only for the login redirect)
SESSION_COOKIE_NAME=qc_session
