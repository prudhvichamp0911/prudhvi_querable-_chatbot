# Queryable Chatbot - backend configuration
#
#   copy this file to .env   (PowerShell:  Copy-Item .env.example .env)
#
# All keys stay on the FastAPI server. The browser never receives them.


# ======================================================================
#  1. YOUR OPENROUTER KEY GOES HERE  <-- the only value you must fill in
# ======================================================================
# Get one at https://openrouter.ai/keys  (it starts with "sk-or-v1-...")
OPENROUTER_API_KEY=

# Model used for routing, query generation and answers.
AGENT_MODEL=google/gemini-2.5-flash


# ---------- VeloDB (Apache Doris) ----------
# Defaults match the container in docker-compose.yml, so for local work you
# do not need to change anything here.
#
# Pointing at a real VeloDB Cloud instance instead: replace host/port/user/
# password with the ones from the VeloDB console. Nothing else changes.
VELODB_HOST=127.0.0.1
VELODB_PORT=9030
VELODB_USER=root
VELODB_PASSWORD=
VELODB_DB=queryable_chatbot
# FE HTTP port (Stream Load and the web UI). Loader only.
VELODB_HTTP_PORT=8030
VELODB_CONNECT_TIMEOUT=5
VELODB_QUERY_TIMEOUT_SECONDS=15

# Optional allowlist of tables the chatbot may query (comma separated).
# Empty = every business table.
QUERYABLE_COLLECTIONS=
MAX_RESULT_ROWS=200

# ---------- Application state ----------
# Users, sessions, API keys, usage counters and chat threads live in SQLite,
# not in VeloDB: that is per-request point read/write traffic, which a
# columnar warehouse handles badly. Leave empty for data/app_state.db.
APP_STATE_DB=

# ---------- OpenUI generation ----------
# openrouter (default): OpenRouter model writes OpenUI Lang with the official prompt.
# thesys: OpenUI Gateway (https://api.thesys.dev/v1/embed) first, OpenRouter as fallback.
OPENUI_PROVIDER=openrouter
OPENUI_MODEL=google/gemini-2.5-flash
# Models users may pick in the model switcher (must be OpenRouter ids)
OPENUI_MODEL_OPTIONS=google/gemini-2.5-flash,openai/gpt-4.1-mini,anthropic/claude-sonnet-4.5
# Separate key; only used when OPENUI_PROVIDER=thesys
THESYS_API_KEY=
THESYS_MODEL=openai/gpt-5
LLM_TIMEOUT_SECONDS=60

# ---------- Jev routing (OpenRouter decisions API) ----------
JEV_ENABLED=true
JEV_MODEL=typesafe/jev-1.13
JEV_TIMEOUT_SECONDS=8
# Below this confidence the LangChain classifier decides instead
JEV_MIN_CONFIDENCE=0.6

# ---------- Authentication ----------
SESSION_COOKIE_NAME=qc_session
SESSION_TTL_MINUTES=480
SESSION_IDLE_MINUTES=60
# true when served over HTTPS
COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
# Self-service "Create account" on the login page (false = admin-created users only)
ALLOW_SIGNUP=true
# New accounts allowed per client IP per hour
SIGNUP_MAX_PER_HOUR=5
# Origin of the Next.js frontend (CSRF origin check and "/" redirect)
FRONTEND_URL=http://localhost:3100

# ---------- Plans & API keys (Settings page) ----------
# Billing is simulated (no payment processor): plans only set limits.
# Free 50 questions/day + 2 keys, Pro 500/day + 10 keys, Team unlimited + 25 keys.
PLAN_LIMITS_ENFORCED=true
DEFAULT_PLAN=free

# ---------- Guardrails ----------
MAX_QUESTION_CHARS=2000
REDACT_PII=true

# ---------- Optional services ----------
# Graphiti + Neo4j context for general answers (needs graphiti-core installed
# and Neo4j on bolt://localhost:7687)
GRAPHITI_ENABLED=false
NEO4J_PASSWORD=
# Langfuse tracing (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------- Speed ----------
# Skip the model's hidden "thinking" pass: about 2x faster answers with the
# same model (measured median 4.8 s vs 8.9 s for query generation).
LLM_FAST_MODE=true
